{
  "name": "huirth-scp-template",
  "license": "GPL-3.0",
  "version": "0.1.0",
  "description": "HuiRth SCP Template - Barebones Co-Located Vue Island Architecture",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "directory": "https://github.com/Phuire-Research/STRATIMUX-TEMPLATE.git"
  },
  "scripts": {
    "bridge": "npm run build:server && npm run build:client && npx nodemon",
    "start": "npm run build:all && node dist/index.js",
    "build": "rimraf ./dist && tsup src/index.ts --format cjs,esm --dts",
    "build:client": "vite build --config vite.client.config.ts",
    "build:server": "vite build --config vite.ssr.config.ts",
    "build:all": "npm run build && npm run build:server && npm run build:client",
    "test": "jest"
  },
  "keywords": [
    "Muxified Turing Machine",
    "Asynchronous Graph Programming",
    "Framework",
    "Template"
  ],
  "author": "Micah T. Keller (public@phuire.org)",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-ws": "^3.0.5",
    "@types/jest": "^28.1.8",
    "@types/node": "^18.6.1",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.20.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jest": "^26.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^28.1.3",
    "nodemon": "^3.0.1",
    "onchange": "^7.1.0",
    "prettier": "^2.7.1",
    "run-script-os": "^1.1.6",
    "ts-jest": "^28.0.7",
    "ts-node": "^10.9.1",
    "tsup": "^8.4.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@replit/codemirror-vim": "^6.3.0",
    "@types/cors": "^2.8.19",
    "@vue/compiler-sfc": "^3.5.26",
    "@vue/server-renderer": "^3.5.26",
    "chokidar": "^3.6.0",
    "codemirror": "^6.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-ws": "^5.0.2",
    "marked": "^18.0.3",
    "nanoid": "^5.1.5",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "stratimux": "0.3.296",
    "vue": "^3.5.26"
  }
}
