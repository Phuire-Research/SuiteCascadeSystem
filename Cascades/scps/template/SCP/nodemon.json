{
  "watch": [
    ".bridge-restart.json"
  ],
  "ignore": [],
  "exec": "npm run build:server && npm run build:client && npx ts-node ./src/index.ts --scp-tag=$PWD",
  "spawn": true,
  "signal": "SIGKILL",
  "delay": "100",
  "verbose": true,
  "events": {
    "restart": "sh ./scripts/lane-teardown.sh 2>/dev/null || true",
    "start": "echo '[Bridge Restart] Fresh process spawned'"
  }
}
