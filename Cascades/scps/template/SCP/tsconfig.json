{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "allowJs": false,
    "outDir": "dist",
    "rootDir": "../",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": ["./src/**/*", "src/concepts/**/*"],
  "exclude": ["./src/**/*.spec.ts"]
}
